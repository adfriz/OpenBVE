#version 430 core

// GL 4.3 compute path for cascaded shadow maps.
// Blurs the raw caster depth once per cascade after the depth pass, so the main shader can
// compare against a soft depth with a single fetch instead of running a multi-tap PCF loop
// per fragment. The GL 4.1 path (5-tap Vogel / 4-tap grid in default.frag) remains unchanged
// and is used whenever this shader is unavailable.

layout(local_size_x = 8, local_size_y = 8) in;

layout(r32f, binding = 0) uniform image2D uFilteredDepth;
uniform sampler2D uDepth;
uniform int uRadius;

void main()
{
	ivec2 size = imageSize(uFilteredDepth);
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	if (p.x >= size.x || p.y >= size.y)
	{
		return;
	}

	float sum = 0.0;
	float totalWeight = 0.0;
	ivec2 upper = size - ivec2(1);

	for (int y = -uRadius; y <= uRadius; ++y)
	{
		for (int x = -uRadius; x <= uRadius; ++x)
		{
			ivec2 tap = clamp(p + ivec2(x, y), ivec2(0), upper);
			float weight = 1.0 / (1.0 + float(x * x + y * y));
			sum += texelFetch(uDepth, tap, 0).r * weight;
			totalWeight += weight;
		}
	}

	imageStore(uFilteredDepth, p, vec4(sum / totalWeight, 0.0, 0.0, 1.0));
}
